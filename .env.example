# Runtime
WOKI_ENV=development
WOKI_DEBUG=true
WOKI_VERSION=dev

# HTTP
WOKI_ADDR=:3000
WOKI_FRONTEND_URL=http://localhost:5173
WOKI_ALLOWED_ORIGIN=http://localhost:5173

# Persistence: postgres (recommended) or file
WOKI_STORAGE_BACKEND=postgres
WOKI_DATA_FILE=data/woki.json

# PostgreSQL
WOKI_DB_ENABLED=true
WOKI_DB_HOST=127.0.0.1
WOKI_DB_PORT=5432
WOKI_DB_USER=woki
WOKI_DB_PASSWORD=woki
WOKI_DB_NAME=woki
WOKI_DB_SSLMODE=disable
WOKI_DB_MIGRATE=true
WOKI_DB_MAX_IDLE_CONNS=10
WOKI_DB_MAX_OPEN_CONNS=50
WOKI_DB_CONN_MAX_LIFETIME=1h

# Redis: sessions, CLI device auth state, distributed rate limiting
WOKI_REDIS_ENABLED=true
WOKI_REDIS_HOST=127.0.0.1
WOKI_REDIS_PORT=6379
WOKI_REDIS_USERNAME=
WOKI_REDIS_PASSWORD=
WOKI_REDIS_DB=0
WOKI_REDIS_PREFIX=woki
WOKI_REDIS_DIAL_TIMEOUT=5s
WOKI_REDIS_READ_TIMEOUT=3s
WOKI_REDIS_WRITE_TIMEOUT=3s
WOKI_REDIS_POOL_TIMEOUT=4s
WOKI_REDIS_MAX_RETRIES=1

# Browser authentication - Google OAuth / Gmail account
WOKI_GOOGLE_CLIENT_ID=
WOKI_GOOGLE_CLIENT_SECRET=
WOKI_GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Optional GitHub OAuth
WOKI_GITHUB_CLIENT_ID=
WOKI_GITHUB_CLIENT_SECRET=

# Development-only direct login
WOKI_DEV_AUTH=true
WOKI_SESSION_COOKIE=woki_session
WOKI_COOKIE_SECURE=false
WOKI_COOKIE_SAME_SITE=strict
WOKI_SESSION_TTL=24h
WOKI_SESSION_REDIS_PREFIX=session

# CLI device authentication
WOKI_DEVICE_CODE_TTL=10m
WOKI_CLI_TOKEN_TTL=720h
WOKI_DEVICE_REDIS_PREFIX=device

# Distributed rate limiting
WOKI_RATE_LIMIT_ENABLED=true
WOKI_RATE_LIMIT_PREFIX=woki:rate
WOKI_RATE_LIMIT_API=600
WOKI_RATE_LIMIT_API_BURST=60
WOKI_RATE_LIMIT_API_WINDOW=1m
WOKI_RATE_LIMIT_AUTH=30
WOKI_RATE_LIMIT_AUTH_BURST=5
WOKI_RATE_LIMIT_AUTH_WINDOW=10m
WOKI_RATE_LIMIT_DEVICE_CODE=10
WOKI_RATE_LIMIT_DEVICE_CODE_BURST=3
WOKI_RATE_LIMIT_DEVICE_CODE_WINDOW=10m
WOKI_RATE_LIMIT_DEVICE_POLL=60
WOKI_RATE_LIMIT_DEVICE_POLL_BURST=10
WOKI_RATE_LIMIT_DEVICE_POLL_WINDOW=1m
WOKI_RATE_LIMIT_MAIL=5
WOKI_RATE_LIMIT_MAIL_BURST=2
WOKI_RATE_LIMIT_MAIL_WINDOW=1h

# Gmail SMTP. Use a Google App Password, not the account password.
WOKI_MAIL_ENABLED=false
WOKI_MAIL_HOST=smtp.gmail.com
WOKI_MAIL_PORT=587
WOKI_MAIL_FROM=support@woki.sh
WOKI_MAIL_PASSWORD=
WOKI_MAIL_NAME=Woki
WOKI_MAIL_SUPPORT_TO=support@woki.sh
WOKI_MAIL_QUEUE_SIZE=128
WOKI_MAIL_WORKERS=2
WOKI_MAIL_SEND_TIMEOUT=15s

# Logging
WOKI_LOG_LEVEL=info
WOKI_LOG_OUTPUT=console
WOKI_LOG_FILE=data/woki.log

# Shutdown
WOKI_SHUTDOWN_TIMEOUT=10s
